# ============================================
# CONFIGURACIÓN DEL SISTEMA - VARIABLES DE ENTORNO
# ============================================
# Copia este archivo como `.env` y rellena los valores.

# --- BASE DE DATOS ---
DB_HOST=localhost
DB_NAME=sistema_otic
DB_USER=
DB_PASS=

# --- ENTORNO ---
# local | production
APP_ENV=local

# --- URL BASE ---
BASE_URL=/proyecto_otic/

# --- RESEND (CORREOS) ---
RESEND_API_KEY=
MAIL_ENABLED=true
MAIL_FROM=onboarding@resend.dev
MAIL_FROM_NAME="Sistema OTIC"

# --- DEBUG ---
DEBUG_MODE=true

# --- 2FA ---
FORZAR_2FA=false

# --- ENCRIPCIÓN ---
ENCRYPTION_KEY=

# --- BLOQUEO ---
BLOQUEO_PREVENTIVO_MINUTOS=15

# --- SEGURIDAD ---
CORS_ALLOWED_ORIGINS=
SECURITY_HEADERS_ENABLED=true